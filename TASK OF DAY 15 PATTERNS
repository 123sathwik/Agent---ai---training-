#floyd's traiangle
num = 1

for i in range(1, 6):

    for j in range(i):
        print(num, end=" ")

        num += 1

    print()
print()
#continuous alphabet traingle

ch = 65

for i in range(1, 6):

    for j in range(i):
        print(chr(ch), end=" ")

        ch += 1

    print()
print()

#inverse right angle traingle 
for i in range(5, 0, -1):
    for j in range(i):
        print("*", end="")
    print()
    
