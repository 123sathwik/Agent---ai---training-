# GET AVAILABLE MOVIES

# =========================================================

@app.post("/available-movies")
def available\_movies(request: MovieRequest):

```
language = request.language.title()

genre = request.genre.title()

if language not in movies:

    raise HTTPException(
        status_code=404,
        detail="Language not available"
    )

if genre not in movies[language]:

    raise HTTPException(
        status_code=404,
        detail="Genre not available"
    )

return {

    "language": language,

    "genre": genre,

    "movies": movies[language][genre]
}
```

# =========================================================

# CREATE USER

# =========================================================

@app.post("/users", response\_model=UserResponse)
def create\_user(user: UserCreate):

```
db = SessionLocal()

try:

    # Duplicate name check

    existing_user = (
        db.query(User)
        .filter(User.name == user.name)
        .first()
    )

    if existing_user:

        raise HTTPException(
            status_code=400,
            detail="User name already exists"
        )

    new_user = User(

        name=user.name,

        email=user.email,

        password=user.password,

        payment_method=user.payment_method,

        payment_done=False
    )

    db.add(new_user)

    db.commit()

    db.refresh(new_user)

    return new_user

finally:

    db.close()
```

# =========================================================

# BOOK MOVIE

# =========================================================

@app.post("/book-movie")
def book\_movie(booking: BookingRequest):

```
db = SessionLocal()

try:

    # Find user

    user = (
        db.query(User)
        .filter(User.name == booking.name)
        .first()
    )

    if not user:

        raise HTTPException(
            status_code=404,
            detail="User not found"
        )

    language = booking.language.title()

    genre = booking.genre.title()

    # Check language

    if language not in movies:

        raise HTTPException(
            status_code=404,
            detail="Language not available"
        )

    # Check genre

    if genre not in movies[language]:

        raise HTTPException(
            status_code=404,
            detail="Genre not available"
        )

    # Check movie

    available = movies[language][genre]

    if booking.movie not in available:

        raise HTTPException(
            status_code=404,
            detail="Movie not available"
        )

    # Payment

    user.payment_method = booking.payment_method

    user.payment_done = True

    db.commit()

    # Random show time

    selected_time = choice(show_times)

    # Current date

    booking_date = datetime.now()

    return {

        "message": "Booking Confirmed!",

        "customer": user.name,

        "email": user.email,

        "language": language,

        "movie_type": genre,

        "movie": booking.movie,

        "show_time": selected_time,

        "booking_date": booking_date.strftime("%d-%b-%Y"),

        "payment_done": user.payment_done,

        "enjoy": "Enjoy your movie!"
    }

finally:

    db.close()
```

