from abc import ABC, abstractmethod
from datetime import datetime


# =====================================================================
# 1. ABSTRACT BASE CLASS
# =====================================================================

class User(ABC):

    def __init__(self, user_id, name, email):
        self._user_id = user_id
        self.name = name
        self.email = email

    @abstractmethod
    def view_dashboard(self):
        pass


# =====================================================================
# 2. COURSE CLASS
# =====================================================================

class Course:

    def __init__(self, course_code, course_name, timeslot):
        self.course_code = course_code
        self.course_name = course_name
        self.timeslot = timeslot
        self.instructor = None
        self.roster = []

    def set_instructor(self, faculty):
        self.instructor = faculty

    def add_student(self, student):

        if student not in self.roster:
            self.roster.append(student)

    def __str__(self):

        instructor = (
            self.instructor.name
            if self.instructor
            else "Not Assigned"
        )

        return (
            f"[{self.course_code}] "
            f"{self.course_name} | "
            f"{self.timeslot} | "
            f"Faculty: {instructor}"
        )


# =====================================================================
# 3. STUDENT CLASS
# =====================================================================

class Student(User):

    def __init__(self, student_id, name, email):

        super().__init__(
            student_id,
            name,
            email
        )

        self.enrolled_courses = []

        # Encapsulation
        self.__grades = {}
        self.__attendance_log = {}

    # -----------------------------------------------------------------
    # ENROLL COURSE
    # -----------------------------------------------------------------

    def enroll(self, course):

        if course in self.enrolled_courses:

            print("\nAlready enrolled in this course.")

            return False

        self.enrolled_courses.append(course)

        course.add_student(self)

        print(
            f"\nSuccessfully enrolled in "
            f"{course.course_code}."
        )

        return True

    # -----------------------------------------------------------------
    # ATTENDANCE
    # -----------------------------------------------------------------

    def mark_attendance(self, status="Present"):

        today = datetime.now().strftime("%Y-%m-%d")

        self.__attendance_log[today] = status.upper()

        print(
            f"\nAttendance marked as {status.upper()}."
        )

    def get_attendance_report(self):

        return self.__attendance_log

    # -----------------------------------------------------------------
    # GRADES
    # -----------------------------------------------------------------

    def add_grade(self, course, grade):

        if course not in self.enrolled_courses:

            print(
                "\nStudent is not enrolled in this course."
            )

            return False

        self.__grades[course] = grade.upper()

        return True

    def get_grades(self):

        return self.__grades

    # -----------------------------------------------------------------
    # DASHBOARD
    # -----------------------------------------------------------------

    def view_dashboard(self):

        print("\n" + "=" * 60)

        print(
            f"STUDENT DASHBOARD - "
            f"{self.name.upper()}"
        )

        print("=" * 60)

        print(f"Student ID : {self._user_id}")
        print(f"Name       : {self.name}")
        print(f"Email      : {self.email}")

        # -------------------------------------------------------------
        # COURSES
        # -------------------------------------------------------------

        print("\n--- ENROLLED COURSES ---")

        if not self.enrolled_courses:

            print("No courses enrolled.")

        else:

            for course in self.enrolled_courses:

                print(
                    f"{course.course_code} - "
                    f"{course.course_name} | "
                    f"{course.timeslot}"
                )

        # -------------------------------------------------------------
        # GRADES
        # -------------------------------------------------------------

        print("\n--- GRADES ---")

        if not self.__grades:

            print("No grades available.")

        else:

            for course, grade in self.__grades.items():

                print(
                    f"{course.course_code} : {grade}"
                )

        # -------------------------------------------------------------
        # ATTENDANCE
        # -------------------------------------------------------------

        print("\n--- ATTENDANCE ---")

        if not self.__attendance_log:

            print("Attendance not marked.")

        else:

            for date, status in self.__attendance_log.items():

                print(
                    f"{date} : {status}"
                )

        print("=" * 60)


# =====================================================================
# 4. UNDERGRADUATE STUDENT
# =====================================================================

class UndergraduateStudent(Student):

    def enroll(self, course):

        if len(self.enrolled_courses) >= 3:

            print(
                "\nEnrollment denied!"
            )

            print(
                "Undergraduate students can "
                "enroll in maximum 3 courses."
            )

            return False

        return super().enroll(course)


# =====================================================================
# 5. GRADUATE STUDENT
# =====================================================================

class GraduateStudent(Student):

    def __init__(
        self,
        student_id,
        name,
        email,
        thesis_topic
    ):

        super().__init__(
            student_id,
            name,
            email
        )

        self.thesis_topic = thesis_topic

    def view_dashboard(self):

        super().view_dashboard()

        print(
            f"\nThesis Topic : "
            f"{self.thesis_topic}"
        )


# =====================================================================
# 6. FACULTY CLASS
# =====================================================================

class Faculty(User):

    def __init__(
        self,
        faculty_id,
        name,
        email,
        department,
        salary
    ):

        super().__init__(
            faculty_id,
            name,
            email
        )

        self.department = department

        self.assigned_courses = []

        # Encapsulation
        self.__salary = salary
        self.__attendance_log = {}

    # -----------------------------------------------------------------
    # ASSIGN COURSE
    # -----------------------------------------------------------------

    def assign_course(self, course):

        if course in self.assigned_courses:

            print(
                "\nCourse already assigned."
            )

            return False

        self.assigned_courses.append(course)

        course.set_instructor(self)

        print(
            f"\nCourse {course.course_code} "
            f"assigned successfully."
        )

        return True

    # -----------------------------------------------------------------
    # ATTENDANCE
    # -----------------------------------------------------------------

    def mark_attendance(self, status="Present"):

        today = datetime.now().strftime("%Y-%m-%d")

        self.__attendance_log[today] = status.upper()

        print(
            f"\nFaculty attendance marked "
            f"as {status.upper()}."
        )

    def get_attendance_report(self):

        return self.__attendance_log

    # -----------------------------------------------------------------
    # SALARY
    # -----------------------------------------------------------------

    def get_salary(self):

        return self.__salary

    # -----------------------------------------------------------------
    # DASHBOARD
    # -----------------------------------------------------------------

    def view_dashboard(self):

        print("\n" + "=" * 60)

        print(
            f"FACULTY DASHBOARD - "
            f"{self.name.upper()}"
        )

        print("=" * 60)

        print(f"Faculty ID  : {self._user_id}")
        print(f"Name        : {self.name}")
        print(f"Email       : {self.email}")
        print(f"Department  : {self.department}")
        print(f"Salary      : ₹{self.__salary:,.2f}")

        # -------------------------------------------------------------
        # ASSIGNED COURSES
        # -------------------------------------------------------------

        print("\n--- ASSIGNED COURSES ---")

        if not self.assigned_courses:

            print("No courses assigned.")

        else:

            for course in self.assigned_courses:

                print(
                    f"{course.course_code} - "
                    f"{course.course_name} | "
                    f"{course.timeslot}"
                )

        # -------------------------------------------------------------
        # STUDENT ROSTER
        # -------------------------------------------------------------

        print("\n--- STUDENT ROSTERS ---")

        if not self.assigned_courses:

            print("No courses assigned.")

        else:

            for course in self.assigned_courses:

                print(
                    f"\nCourse: {course.course_code}"
                )

                if not course.roster:

                    print("  No students enrolled.")

                else:

                    for student in course.roster:

                        print(
                            f"  - "
                            f"{student._user_id} | "
                            f"{student.name}"
                        )

        print("=" * 60)


# =====================================================================
# 7. UNIVERSITY CLASS
# =====================================================================

class University:

    def __init__(self, name):

        self.name = name

        self.students = {}

        self.faculty_members = {}

        self.courses = {}

    # -----------------------------------------------------------------
    # ADD STUDENT
    # -----------------------------------------------------------------

    def add_student(self, student):

        if student._user_id in self.students:

            print(
                "\nStudent ID already exists."
            )

            return False

        self.students[student._user_id] = student

        print(
            "\nStudent added successfully."
        )

        return True

    # -----------------------------------------------------------------
    # ADD FACULTY
    # -----------------------------------------------------------------

    def add_faculty(self, faculty):

        if faculty._user_id in self.faculty_members:

            print(
                "\nFaculty ID already exists."
            )

            return False

        self.faculty_members[faculty._user_id] = faculty

        print(
            "\nFaculty added successfully."
        )

        return True

    # -----------------------------------------------------------------
    # ADD COURSE
    # -----------------------------------------------------------------

    def add_course(self, course):

        if course.course_code in self.courses:

            print(
                "\nCourse code already exists."
            )

            return False

        self.courses[course.course_code] = course

        print(
            "\nCourse added successfully."
        )

        return True


