def assign_faculty_to_course(system):

    if not system.faculty_members:

        print(
            "\nNo faculty members available."
        )

        return

    if not system.courses:

        print(
            "\nNo courses available."
        )

        return

    print("\n--- FACULTY ---")

    for faculty in system.faculty_members.values():

        print(
            f"{faculty._user_id} - "
            f"{faculty.name}"
        )

    faculty_id = input(
        "\nEnter Faculty ID: "
    ).strip().upper()

    if faculty_id not in system.faculty_members:

        print(
            "\nFaculty not found."
        )

        return

    print("\n--- COURSES ---")

    for course in system.courses.values():

        print(
            f"{course.course_code} - "
            f"{course.course_name}"
        )

    course_code = input(
        "\nEnter Course Code: "
    ).strip().upper()

    if course_code not in system.courses:

        print(
            "\nCourse not found."
        )

        return

    faculty = system.faculty_members[faculty_id]

    course = system.courses[course_code]

    faculty.assign_course(course)


