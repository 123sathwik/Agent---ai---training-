        )

        print("=" * 45)

        print("1. View Dashboard")
        print("2. Mark Attendance")
        print("3. Assign Student Grade")
        print("4. Logout")

        choice = input(
            "\nEnter choice: "
        ).strip()

        # -------------------------------------------------------------
        # DASHBOARD
        # -------------------------------------------------------------

        if choice == "1":

            faculty.view_dashboard()

        # -------------------------------------------------------------
        # ATTENDANCE
        # -------------------------------------------------------------

        elif choice == "2":

            print("\n1. Present")
            print("2. Absent")

            status_choice = input(
                "Enter choice: "
            ).strip()

            if status_choice == "1":

                faculty.mark_attendance("Present")

            elif status_choice == "2":

                faculty.mark_attendance("Absent")

            else:

                print(
                    "\nInvalid attendance choice."
                )

        # -------------------------------------------------------------
        # ASSIGN GRADE
        # -------------------------------------------------------------

        elif choice == "3":

            if not system.students:

                print(
                    "\nNo students available."
                )

                continue

            print("\n--- STUDENTS ---")

            for student in system.students.values():

                print(
                    f"{student._user_id} - "
                    f"{student.name}"
                )

            student_id = input(
                "\nEnter Student ID: "
            ).strip().upper()

            if student_id not in system.students:

                print(
                    "\nStudent not found."
                )

                continue

            student = system.students[student_id]

            if not student.enrolled_courses:

                print(
                    "\nThis student has "
                    "no enrolled courses."
                )

                continue

            print(
                f"\nCourses of {student.name}:"
            )

            for course in student.enrolled_courses:

                print(
                    f"{course.course_code} - "
                    f"{course.course_name}"
                )

            course_code = input(
                "\nEnter Course Code: "
            ).strip().upper()

            matching_course = None

            for course in student.enrolled_courses:

                if course.course_code == course_code:

                    matching_course = course

                    break

            if matching_course is None:

                print(
                    "\nStudent is not enrolled "
                    "in this course."
                )

                continue

            grade = input(
                "\nEnter Grade "
                "(A+, A, B+, B, C, etc.): "
            ).strip().upper()

            student.add_grade(
                matching_course,
                grade
            )

            print(
                "\nGrade assigned successfully."
            )

        # -------------------------------------------------------------
        # LOGOUT
        # -------------------------------------------------------------

        elif choice == "4":

            print(
                "\nLogged out successfully."
            )

            break

        else:

            print(
                "\nInvalid choice."
            )


