# 15. STUDENT LOGIN MENU
# =====================================================================

def student_login(system):

    student_id = input(
        "\nEnter Student ID: "
    ).strip().upper()

    if student_id not in system.students:

        print(
            "\nStudent ID not found."
        )

        return

    student = system.students[student_id]

    while True:

        print("\n" + "=" * 45)

        print(
            f"STUDENT MENU - {student.name}"
        )

        print("=" * 45)

        print("1. View Dashboard")
        print("2. Mark Attendance")
        print("3. Enroll in Course")
        print("4. View Grades")
        print("5. Logout")

        choice = input(
            "\nEnter choice: "
        ).strip()

        # -------------------------------------------------------------
        # DASHBOARD
        # -------------------------------------------------------------

        if choice == "1":

            student.view_dashboard()

        # -------------------------------------------------------------
        # ATTENDANCE
        # -------------------------------------------------------------

        elif choice == "2":

            print("\n1. Present")
            print("2. Absent")

            status_choice = input(
                "Enter choice: "
            ).strip()

            if status_choice == "1":

                student.mark_attendance("Present")

            elif status_choice == "2":

                student.mark_attendance("Absent")

            else:

                print(
                    "\nInvalid attendance choice."
                )

        # -------------------------------------------------------------
        # ENROLL
        # -------------------------------------------------------------

        elif choice == "3":

            display_courses(system)

            course_code = input(
                "\nEnter Course Code: "
            ).strip().upper()

            if course_code in system.courses:

                student.enroll(
                    system.courses[course_code]
                )

            else:

                print(
                    "\nInvalid Course Code."
                )

        # -------------------------------------------------------------
        # GRADES
        # -------------------------------------------------------------

        elif choice == "4":

            grades = student.get_grades()

            print("\n--- YOUR GRADES ---")

            if not grades:

                print("No grades available.")

            else:

                for course, grade in grades.items():

                    print(
                        f"{course.course_code} : "
                        f"{grade}"
                    )

        # -------------------------------------------------------------
        # LOGOUT
        # -------------------------------------------------------------

        elif choice == "5":

            print(
                "\nLogged out successfully."
            )

            break

        else:

            print(
                "\nInvalid choice."
            )


