# task of printing the A B C D E F G H USING CHAR AND ORD WE WILL GET THE VALUE AND CHAR WILL GIVE THE ALPHABET OF THAT ASCII VALUE
print(ord('A'))
print(chr(65))
#using these two we have used for loop the ord will always return ascii value so we need that ascii value converetd to char so i used chr
#and range is from A to 8 elemenets
#i have given start and stop 
for i in range(ord('A'), ord('A') + 8):
    print(chr(i), end=" ")
print()

#similarly i need only H F D B so i used -2 
for i in range(ord('H'), ord('A') - 1, -2):
    print(chr(i), end=" ")
print()  

