n = 5

# Upper Half
for i in range(1, n + 1):
    for j in range(1, n + 1):
        if j <= n - i:
            print(" ", end="")
        else:
            print("* ", end="")
    print()

# Lower Half
for i in range(n - 1, 0, -1):
    for j in range(1, n + 1):
        if j <= n - i:
            print(" ", end="")
        else:
            print("* ", end="")
    print()
